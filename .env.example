# Every variable agent-voice reads. Settings themselves live in ~/.agent-voice/config.json; change them with `agent-voice config`.
# From source: copy this file to .env and fill in a value; `pnpm cli` loads it. An empty value keeps the default.
# Installed agent-voice: export the variable in your shell profile instead.

# Folder for agent-voice's config, state, models, and logs. Default: ~/.agent-voice.
AGENT_VOICE_HOME=

# Path to the config file. When set, it is the only config file read. Default: $AGENT_VOICE_HOME/config.json.
AGENT_VOICE_CONFIG_FILE=

# Forces the Whisper model: turbo-q5, turbo-q8, turbo, small, base, tiny, or ivrit. Overrides the dictation-model setting. Default: unset.
AGENT_VOICE_DICTATION_MODEL=

# Set to off (or 0, false, no) to stop the live caption while Shift is held. Default: on.
AGENT_VOICE_DICTATION_LIVE_PREVIEW=

# Set to off (or 0, false, no) so a failed refine never opens the macOS model picker (CI, headless Macs). Default: on.
AGENT_VOICE_REFINE_PICKER=
