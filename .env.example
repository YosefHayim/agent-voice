# Every variable voxkey reads. Settings themselves live in ~/.voxkey/config.json; change them with `voxkey config`.
# From source: copy this file to .env and fill in a value; `pnpm cli` loads it. An empty value keeps the default.
# Installed voxkey: export the variable in your shell profile instead.

# Folder for voxkey's config, state, models, and logs. Default: ~/.voxkey.
VOXKEY_HOME=

# Path to the config file. When set, it is the only config file read. Default: $VOXKEY_HOME/config.json.
VOXKEY_CONFIG_FILE=

# Forces the Whisper model: turbo-q5, turbo-q8, turbo, small, base, tiny, or ivrit. Default: dictation-language picks turbo-q5 or ivrit.
VOXKEY_DICTATION_MODEL=

# Set to off (or 0, false, no) to stop the live caption while Shift is held. Default: on.
VOXKEY_DICTATION_LIVE_PREVIEW=

# Set to off (or 0, false, no) so a failed refine never opens the macOS model picker (CI, headless Macs). Default: on.
VOXKEY_REFINE_PICKER=
