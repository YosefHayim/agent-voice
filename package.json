{
  "name": "agent-voice",
  "version": "0.0.0",
  "private": true,
  "description": "Hold Shift to dictate into any text field and hear coding-agent replies read aloud, all on your Mac.",
  "type": "module",
  "bin": {
    "agent-voice": "dist/src/cli/main.js"
  },
  "scripts": {
    "dev": "tsx watch src/scripts/cli-from-source.ts status",
    "dev:cli": "tsx src/scripts/cli-from-source.ts",
    "prod": "pnpm build && node dist/src/cli/main.js status",
    "prepare": "husky",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc && node -e \"require('node:fs').chmodSync('dist/src/cli/main.js',0o755)\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bench": "tsx src/scripts/bench-dictation.ts",
    "lint": "biome check . && knip",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check": "turbo run lint typecheck test build --output-logs=errors-only"
  },
  "license": "MIT",
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.11",
  "dependencies": {
    "@effect/cli": "0.77.2",
    "@effect/platform": "0.97.3",
    "@effect/platform-node": "0.108.4",
    "@fugood/whisper.node": "1.1.3",
    "@picovoice/pvrecorder-node": "1.2.9",
    "effect": "3.22.4",
    "jsonc-parser": "3.3.1",
    "koffi": "3.3.7",
    "onnxruntime-node": "1.31.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "22.20.5",
    "husky": "9.1.7",
    "knip": "6.44.2",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
